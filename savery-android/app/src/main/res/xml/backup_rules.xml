<?xml version="1.0" encoding="utf-8"?>
<!--
    backup_rules.xml — required by android:fullBackupContent attribute on API < 31.
    Excludes all sensitive financial data from backups on older devices.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
    <exclude domain="sharedpref" path="." />
    <!-- Allow only theme preference -->
    <include domain="sharedpref" path="savery_settings.preferences_pb" />
</full-backup-content>
